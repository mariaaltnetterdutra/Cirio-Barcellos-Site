# Copie para .env e preencha. O .env nunca vai para o git.
NODE_ENV=development
PORT=3001
# Endereço do site que pode chamar a API (CORS).
CORS_ORIGIN=http://localhost:3000
# MongoDB local (MongoDB Community) ou do MongoDB Atlas (mongodb+srv://usuario:senha@cluster/...).
MONGODB_URI=mongodb://127.0.0.1:27017/cirio-barcellos

# Email que avisa a equipe a cada pedido novo (nunca vai para o cliente).
# Em desenvolvimento pode ficar tudo vazio: o texto do email aparece só no terminal.
# Em produção todos são obrigatórios. Porta 587 (STARTTLS) ou 465 (SSL).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Remetente, ex.: Site Círio & Barcellos <avisos@seudominio.com.br>
MAIL_FROM=
# Quem recebe, ex.: priscila@seudominio.com.br,vinicius@seudominio.com.br
MAIL_TO=
