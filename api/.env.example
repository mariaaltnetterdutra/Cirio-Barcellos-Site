# Copie para .env e preencha. O .env nunca vai para o git.
NODE_ENV=development
PORT=3001
# Endereço do site que pode chamar a API (CORS).
CORS_ORIGIN=http://localhost:3000
# MongoDB local (MongoDB Community) ou do MongoDB Atlas (mongodb+srv://usuario:senha@cluster/...).
MONGODB_URI=mongodb://127.0.0.1:27017/cirio-barcellos
